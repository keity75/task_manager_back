# ==============================================================================
# Task Manager backend - 環境変数設定ファイル（テンプレート）
# ==============================================================================
# このファイルは Git 管理対象です。機密情報は含めないでください。
# 実際の開発時は、このファイルを `.env` にコピーして使用してください。
#
# コピーコマンド:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# アプリケーション基本設定
# ------------------------------------------------------------------------------
# ログレベル (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# ローカル開発では DEBUG を推奨
LOG_LEVEL=DEBUG

# フロントエンドURL (CORS設定で使用)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OAuth2プロバイダー設定 (プロバイダートークンリフレッシュ用)
# ------------------------------------------------------------------------------
# Google OAuth2 クライアントID
# - フロントエンド(NextAuth.js)と同一の値を設定
GOOGLE_CLIENT_ID=

# Google OAuth2 クライアントシークレット
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 暗号化設定 (プロバイダートークン暗号化用)
# ------------------------------------------------------------------------------
# プロバイダートークンの暗号化に使用する鍵 (64文字のhex文字列)
# - 生成コマンド: openssl rand -hex 32
# - フロントエンド(NextAuth.js)と同一の値を設定
ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# JWT認証設定
# ------------------------------------------------------------------------------
# バックエンドAPIトークン(JWT)の署名検証に使用する秘密鍵
# - フロントエンドのNEXTAUTH_SECRETとは別の値を設定
# - 生成コマンド: openssl rand -hex 32
BACKEND_JWT_SECRET=

# ------------------------------------------------------------------------------
# Google Cloud 設定
# ------------------------------------------------------------------------------
# Google Cloud プロジェクトID
GOOGLE_CLOUD_PROJECT=task-manager-dev

# Firestore Emulator プロジェクトID (ローカル開発時のみ使用)
# - エミュレーター専用のプロジェクトID
FIRESTORE_EMULATOR_PROJECT=demo-task-manager

# Firestore Emulator接続先 (ローカル開発時のみ使用)
# docker-composeのサービス名を指定
FIRESTORE_EMULATOR_HOST=firestore:8080

# ------------------------------------------------------------------------------
# メールドメイン制限
# ------------------------------------------------------------------------------
# 許可するメールドメイン (JSON配列形式、空配列=制限なし)
ALLOWED_EMAIL_DOMAINS=[]
