# Python bytecode
__pycache__/
*.pyc

# Distribution / packaging
build/
dist/
*.egg-info/

# C extensions
*.so

# Tool Caches
.pytest_cache/
.ruff_cache/

# Poetry Virtual Environment
.venv/

# Firebase Emulator Data (Existing)
firebase/firestore/bin/
firebase/firestore/config/

# Environment Variables - Do not commit secrets!
.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# VSCode IDE - Ignore all by default...
.vscode/*
# ...but explicitly include shared team settings.
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json.claude/
